generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  email     String
  password  String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("user")
}
